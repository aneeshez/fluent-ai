DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-before-use
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GROQ_API_KEY=your_groq_api_key

# Leave unset for local SQLite. Production must use a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/fluentai

# Use these for production deployments behind an HTTPS-terminating proxy.
# SECURE_SSL_REDIRECT=True
# TRUST_PROXY_SSL_HEADER=True
# TRUST_PROXY_IP_HEADER=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DEFAULT_FROM_EMAIL=FluentAI <no-reply@your-domain.example>
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
